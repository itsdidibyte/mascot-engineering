{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mascot-engineering/build_spec-2.0.0.json",
  "title": "Mascot engineering build spec v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character_id", "package_mode", "scale", "coordinate_system", "root_anchor",
               "canvas", "source_references", "views", "materials", "components", "unresolved_issues"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "pos3": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
    "status": {"enum": ["observed", "inferred", "approved_design", "proposed", "unknown"]},
    "segments": {"type": "integer", "minimum": 8, "maximum": 256},
    "geometry": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "radii"],
         "properties": {"type": {"const": "ellipsoid"}, "radii": {"$ref": "#/$defs/pos3"},
                        "segments": {"$ref": "#/$defs/segments"}, "rings": {"type": "integer", "minimum": 4, "maximum": 256}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "radii", "exponents"],
         "properties": {"type": {"const": "superellipsoid"}, "radii": {"$ref": "#/$defs/pos3"},
                        "exponents": {"type": "array", "items": {"type": "number", "minimum": 0.5, "maximum": 20}, "minItems": 2, "maxItems": 2},
                        "segments": {"$ref": "#/$defs/segments"}, "rings": {"type": "integer", "minimum": 4, "maximum": 256}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "dimensions"],
         "properties": {"type": {"const": "box"}, "dimensions": {"$ref": "#/$defs/pos3"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "radius", "depth"],
         "properties": {"type": {"const": "cylinder"}, "radius": {"type": "number", "exclusiveMinimum": 0},
                        "depth": {"type": "number", "exclusiveMinimum": 0}, "vertices": {"$ref": "#/$defs/segments"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "radius", "length"],
         "properties": {"type": {"const": "capsule"}, "radius": {"type": "number", "exclusiveMinimum": 0},
                        "radius_top": {"type": "number", "exclusiveMinimum": 0},
                        "length": {"type": "number", "minimum": 0}, "segments": {"$ref": "#/$defs/segments"},
                        "cap_rings": {"type": "integer", "minimum": 2, "maximum": 64}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "profile"],
         "properties": {"type": {"const": "revolved_profile"},
                        "profile": {"type": "array", "minItems": 2,
                                    "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
                        "segments": {"$ref": "#/$defs/segments"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "stations"],
         "properties": {"type": {"const": "elliptical_loft"},
                        "stations": {"type": "array", "minItems": 2,
                                     "items": {"type": "array", "items": {"type": "number"}, "minItems": 5, "maxItems": 5}},
                        "n": {"type": "number", "minimum": 0.5, "maximum": 20}, "segments": {"$ref": "#/$defs/segments"}}}
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "character_id": {"$ref": "#/$defs/id"},
    "design_version": {"type": "string"},
    "package_mode": {"enum": ["SPEC_ONLY", "BLOCKOUT_READY", "PRODUCTION_READY"]},
    "scale": {
      "type": "object", "additionalProperties": false, "required": ["mode", "unit", "character_height"],
      "properties": {"mode": {"enum": ["relative", "metric"]}, "unit": {"enum": ["normalized", "m"]},
                     "character_height": {"type": "number", "exclusiveMinimum": 0}, "anchor_note": {"type": "string"}}
    },
    "coordinate_system": {"const": "BLENDER_Z_UP_FACING_NEG_Y_X_LEFT"},
    "root_anchor": {"type": "string", "minLength": 1},
    "canvas": {
      "type": "object", "additionalProperties": false, "required": ["world_size", "center_h", "center_z", "resolution_px"],
      "properties": {"world_size": {"type": "number", "exclusiveMinimum": 0}, "center_h": {"type": "number"},
                     "center_z": {"type": "number"}, "resolution_px": {"type": "integer", "minimum": 64, "maximum": 8192}}
    },
    "source_references": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "relative_path", "sha256", "origin"],
                "properties": {"id": {"$ref": "#/$defs/id"}, "relative_path": {"type": "string"},
                               "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                               "original_filename": {"type": "string"},
                               "image_size_px": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
                               "color_mode": {"type": "string"},
                               "origin": {"enum": ["ai_generated", "hand_drawn", "render_3d", "photo", "third_party", "unknown"]},
                               "rights_note": {"type": "string"}, "notes": {"type": "string"}}}
    },
    "views": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "source_reference_id", "kind", "projection", "role"],
                "properties": {"id": {"$ref": "#/$defs/id"}, "source_reference_id": {"type": ["string", "null"]},
                               "kind": {"enum": ["front", "back", "left", "right", "three_quarter_left", "three_quarter_right", "other"]},
                               "yaw_deg_estimate": {"type": ["number", "null"]},
                               "projection": {"enum": ["orthographic_assumed", "orthographic_known", "perspective_unknown", "perspective_known"]},
                               "role": {"enum": ["canonical", "supporting", "rejected"]},
                               "normalization": {"type": ["object", "null"]},
                               "camera_cv": {"type": ["object", "null"], "additionalProperties": false,
                                             "required": ["fx", "fy", "cx", "cy", "R_world_to_cv", "t_world_to_cv"],
                                             "properties": {"fx": {"type": "number", "exclusiveMinimum": 0}, "fy": {"type": "number", "exclusiveMinimum": 0},
                                                            "cx": {"type": "number"}, "cy": {"type": "number"},
                                                            "R_world_to_cv": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vec3"}},
                                                            "t_world_to_cv": {"$ref": "#/$defs/vec3"}}},
                               "notes": {"type": "string"}}}
    },
    "materials": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "base_color_rgba"],
                "properties": {"id": {"$ref": "#/$defs/id"},
                               "base_color_rgba": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4},
                               "roughness": {"type": "number", "minimum": 0, "maximum": 1},
                               "metallic": {"type": "number", "minimum": 0, "maximum": 1},
                               "evidence_status": {"$ref": "#/$defs/status"}, "notes": {"type": "string"}}}
    },
    "components": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
                "required": ["id", "name", "parent_id", "geometry", "location", "rotation_euler_deg", "material_id", "evidence"],
                "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
                               "parent_id": {"type": ["string", "null"]}, "geometry": {"$ref": "#/$defs/geometry"},
                               "location": {"$ref": "#/$defs/vec3"}, "rotation_euler_deg": {"$ref": "#/$defs/vec3"},
                               "rotation_mode": {"const": "XYZ"}, "scale": {"$ref": "#/$defs/pos3"},
                               "mirror": {"type": "object", "additionalProperties": false, "required": ["id"],
                                          "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}}},
                               "material_id": {"type": "string"},
                               "smooth": {"type": "object", "additionalProperties": false,
                                          "properties": {"subdivision_levels": {"type": "integer", "minimum": 0, "maximum": 4}}},
                               "articulation": {"enum": ["rigid", "deformable", "cloth", "none"]},
                               "evidence": {"type": "object", "additionalProperties": false, "required": ["status", "method", "reference_ids"],
                                            "properties": {"status": {"$ref": "#/$defs/status"}, "method": {"type": "string", "minLength": 1},
                                                           "reference_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                                                           "parameters": {"type": "object"},
                                                           "uncertainty_note": {"type": "string"}, "decision_id": {"type": "string"}}},
                               "notes": {"type": "string"}}}
    },
    "decisions": {"type": "array", "items": {"type": "object", "required": ["id", "gate", "summary"],
                                             "properties": {"id": {"type": "string"}, "gate": {"type": "string"},
                                                            "summary": {"type": "string"}, "decided_by": {"type": "string"},
                                                            "date": {"type": "string"}, "affects": {"type": "array", "items": {"type": "string"}}}}},
    "unresolved_issues": {"type": "array", "items": {"oneOf": [
      {"type": "string"},
      {"type": "object", "required": ["id", "gate", "severity", "text"],
       "properties": {"id": {"type": "string"}, "gate": {"type": "string"},
                      "severity": {"enum": ["blocking", "major", "minor", "info"]}, "text": {"type": "string"}}}]}},
    "release_evidence": {"type": "object", "properties": {"blender_build_log": {"type": "string"}, "compare_report": {"type": "string"}}},
    "notes": {"type": "string"}
  }
}
